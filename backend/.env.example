# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the web app
# The Android app does not use CORS, only the webapp does
CORS_ORIGINS=["http://localhost:3000"]
# Production example:
# CORS_ORIGINS=["https://app.yourdomain.com"]

# ── Solana RPC ─────────────────────────────────────────────────────────────────
# Use a dedicated RPC provider URL. Public Solana RPC endpoints commonly reject hosted app traffic.
# For production mainnet, set both values to the same provider URL.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-api-key
SOLANA_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-api-key

# ── Solana Program IDs ─────────────────────────────────────────────────────────
# These are REQUIRED — run `anchor deploy` and paste the output IDs here.
# The app will not start without them.
ESCROW_PROGRAM_ID=

# ── Seeker-specific addresses ──────────────────────────────────────────────────
# These are REQUIRED — get them from the Seeker team or your on-chain deployment.
SEEKER_GENESIS_COLLECTION=GT22s89nU4iWFkNXj1Bw6uYhJJWDRPpShHt4Bk8f99Te
SKR_TOKEN_MINT=SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3

# ── USDC mint ─────────────────────────────────────────────────────────────────
# Devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Builder Pass price in raw USDC units (6 decimals).
BUILDER_PASS_PRICE_USDC=50000000

# Server-side only. Never expose this value in Android or a public web env var.
CHERRY_APP_SECRET=
