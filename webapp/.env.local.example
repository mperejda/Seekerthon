# Server-side URL of the FastAPI backend (no trailing slash).
# Browser requests use /api/v1 on the web app origin to preserve session cookies.
# Local development:
BACKEND_URL=http://localhost:8000
# Production example:
# BACKEND_URL=https://api.yourdomain.com
# Existing NEXT_PUBLIC_API_URL values are also supported as a fallback.

# Server-side Solana RPC used by /api/rpc for wallet simulation, send, and confirmation.
# Use a dedicated mainnet RPC provider URL. Do not rely on the public Solana endpoint in production.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-api-key

# Browser wallet endpoint. Keep this as /api/rpc so the RPC provider key stays server-side.
NEXT_PUBLIC_RPC_URL=/api/rpc
